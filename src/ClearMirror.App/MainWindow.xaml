<Window x:Class="ClearMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearMirror" Width="1180" Height="790" MinWidth="1030" MinHeight="700"
        Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                        <Grid>
                            <Border Width="20" Height="29" CornerRadius="4" BorderBrush="#08130F" BorderThickness="2" />
                            <Ellipse Width="4" Height="4" Fill="#08130F" VerticalAlignment="Bottom" Margin="0,0,0,9" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ClearMirror" FontSize="22" FontWeight="Bold" />
                        <TextBlock Text="High-quality Android screen &amp; audio mirroring" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" Background="#13271F" BorderBrush="#245F4C" BorderThickness="1" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="Ready" Foreground="#A9F9DC" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="DEVICE" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Connect your Android" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,3" />
                        <TextBlock Text="Enable USB debugging, then connect with a good data cable." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14" />
                        <ComboBox x:Name="DeviceCombo" DisplayMemberPath="DisplayName" SelectionChanged="DeviceCombo_SelectionChanged" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Refresh" Style="{StaticResource SecondaryButton}" Click="RefreshDevices_Click" />
                            <Button Grid.Column="2" Content="ADB help" Style="{StaticResource SecondaryButton}" Click="AdbHelp_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="WI-FI CONNECTION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Wireless debugging address" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,8" />
                        <TextBox x:Name="WifiAddressText" Text="192.168.1.10:5555" />
                        <Button Content="Connect over Wi-Fi" Style="{StaticResource SecondaryButton}" Click="WifiConnect_Click" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="QUICK OPTIONS" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <CheckBox x:Name="ObsModeCheck" Content="OBS clean window (borderless + topmost)" Checked="ObsModeCheck_Changed" Unchecked="ObsModeCheck_Changed" />
                        <CheckBox x:Name="RecordCheck" Content="Record video + audio (MKV)" />
                        <CheckBox x:Name="ScreenOffCheck" Content="Turn phone screen off while mirroring" />
                        <CheckBox x:Name="ReadOnlyCheck" Content="View only (disable PC control)" />
                        <Button x:Name="GamingControlsButton" Content="Gaming Controls (keyboard + mouse)" Style="{StaticResource SecondaryButton}" Click="GamingControls_Click" Margin="0,12,0,0" />
                        <TextBlock Text="Start mirroring first. F12 edits keys; Ctrl locks/unlocks mouse-look."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="VIDEO QUALITY" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Resolution" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,5" />
                            <ComboBox x:Name="ResolutionCombo" SelectedIndex="1">
                                <ComboBoxItem Content="720p · Fast" Tag="1280" />
                                <ComboBoxItem Content="1080p · Recommended" Tag="1920" />
                                <ComboBoxItem Content="1440p · Ultra" Tag="2560" />
                                <ComboBoxItem Content="Native resolution" Tag="0" />
                            </ComboBox>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Frame rate" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" />
                                    <ComboBox x:Name="FpsCombo" SelectedIndex="1">
                                        <ComboBoxItem Content="30 FPS" Tag="30" />
                                        <ComboBoxItem Content="60 FPS" Tag="60" />
                                        <ComboBoxItem Content="90 FPS" Tag="90" />
                                        <ComboBoxItem Content="120 FPS" Tag="120" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Codec" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" />
                                    <ComboBox x:Name="VideoCodecCombo" SelectedIndex="1">
                                        <ComboBoxItem Content="H.264 · Compatible" Tag="h264" />
                                        <ComboBoxItem Content="H.265 · Clearer" Tag="h265" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Video bitrate" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,5" />
                            <ComboBox x:Name="VideoBitrateCombo" SelectedIndex="2">
                                <ComboBoxItem Content="8 Mbps" Tag="8" />
                                <ComboBoxItem Content="12 Mbps" Tag="12" />
                                <ComboBoxItem Content="20 Mbps · Recommended" Tag="20" />
                                <ComboBoxItem Content="30 Mbps · Ultra" Tag="30" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CLEAR AUDIO" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="Audio codec" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,5" />
                            <ComboBox x:Name="AudioCodecCombo" SelectedIndex="0">
                                <ComboBoxItem Content="Opus · Recommended" Tag="opus" />
                                <ComboBoxItem Content="AAC · Compatible" Tag="aac" />
                            </ComboBox>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Bitrate" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" />
                                    <ComboBox x:Name="AudioBitrateCombo" SelectedIndex="1">
                                        <ComboBoxItem Content="128 kbps" Tag="128" />
                                        <ComboBoxItem Content="192 kbps" Tag="192" />
                                        <ComboBoxItem Content="256 kbps" Tag="256" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Buffer" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,5" />
                                    <ComboBox x:Name="AudioBufferCombo" SelectedIndex="1">
                                        <ComboBoxItem Content="30 ms · Low" Tag="30" />
                                        <ComboBoxItem Content="50 ms · Stable" Tag="50" />
                                        <ComboBoxItem Content="100 ms · Smooth" Tag="100" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="GameMicAudioCheck" Content="Game mic audio mode (Android 13+)" Margin="0,10,0,0" ToolTip="Try alternate playback capture if enabling the phone's in-game mic silences PC audio. Stop and restart mirroring to apply. Some apps and call audio cannot be captured." />
                            <CheckBox x:Name="KeepPhoneAudioCheck" Content="Keep sound playing on phone (Android 13+)" />
                            <CheckBox x:Name="MuteCheck" Content="Disable audio forwarding" />
                            <Button Content="PC microphone → phone" Style="{StaticResource SecondaryButton}" Click="Microphone_Click" Margin="0,10,0,0" />
                            <TextBlock Text="Requires an audio cable/interface into the phone's mic input." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" MinHeight="60">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="ACTIVITY LOG" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                            <Button Content="Clear" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="12,5" Click="ClearLog_Click" />
                        </Grid>
                        <TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AcceptsReturn="True" />
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button x:Name="StartButton" Grid.Column="0" Content="Start mirroring" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="StartMirror_Click" />
                    <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Style="{StaticResource DangerButton}" MinWidth="95" IsEnabled="False" Click="StopMirror_Click" />
                    <TextBlock Grid.Column="4" Text="USB recommended for lowest latency" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#070B11" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <TextBlock x:Name="FooterStatusText" Text="Engine: checking…" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="ClearMirror 1.1.1  ·  Powered by scrcpy" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
