<Window x:Class="ClearMirror.App.WifiPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClearMirror · Wireless setup" Width="720" Height="650" MinWidth="660" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        Loaded="Window_Loaded">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Wireless Android setup" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Discover, pair, and connect without leaving ClearMirror" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="16" Background="#13271F" BorderBrush="#245F4C" BorderThickness="1" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Ready to scan" Foreground="#A9F9DC" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DISCOVERED DEVICES" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button x:Name="ScanButton" Content="Scan Wi-Fi" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="13,6" Click="Scan_Click" />
                        </Grid>
                        <TextBlock Text="Only Android phones with Wireless debugging enabled can appear." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,10" />
                        <ListBox x:Name="ServicesList" DisplayMemberPath="DisplayName" SelectionChanged="ServicesList_SelectionChanged"
                                 Height="150" Background="#0D141E" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="4" />
                        <TextBlock x:Name="DiscoveryHint" Text="On your phone: Developer options → Wireless debugging → On" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="HOW TO PAIR" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="1. Phone ও PC একই Wi-Fi-তে রাখুন.&#x0a;2. Phone-এ Pair device with pairing code খুলুন.&#x0a;3. Scan Wi-Fi চাপুন এবং Ready to pair item select করুন.&#x0a;4. 6-digit code দিয়ে Pair &amp; connect চাপুন."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="FIRST-TIME PAIRING" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Pairing IP &amp; port" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,11,0,5" />
                        <TextBox x:Name="PairAddressText" ToolTip="Address shown inside Pair device with pairing code" />
                        <TextBlock Text="6-digit pairing code" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,5" />
                        <PasswordBox x:Name="PairCodeText" MaxLength="6" Background="#0D141E" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10,8" />
                        <Button x:Name="PairButton" Content="Pair &amp; connect" Style="{StaticResource PrimaryButton}" Click="Pair_Click" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="DIRECT CONNECTION" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Main Wireless debugging IP &amp; port" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,11,0,5" />
                        <TextBox x:Name="ConnectAddressText" ToolTip="Main IP address &amp; Port shown on Wireless debugging page" />
                        <Button x:Name="ConnectButton" Content="Connect selected device" Style="{StaticResource SecondaryButton}" Click="Connect_Click" Margin="0,11,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#101B27" BorderBrush="#28445E" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                    <TextBlock x:Name="ResultText" Text="Tip: the pairing port and connection port are usually different." Foreground="#AFC4DA" FontSize="11" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="5 GHz Wi-Fi recommended for 1080p/60 FPS" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="90" Click="Cancel_Click" />
            <Button Grid.Column="3" Content="Done" Style="{StaticResource PrimaryButton}" MinWidth="100" Click="Done_Click" />
        </Grid>
    </Grid>
</Window>
